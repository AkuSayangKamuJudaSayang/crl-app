generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  teacher
  admin
}

enum AssessmentPeriod {
  BoSY
  MoSY
  EoSY
}

enum MiscueType {
  Insertion
  Omission
  Substitution
  Repetition
  SelfCorrection
  Reversion
}

model User {
  id             Int          @id @default(autoincrement())
  username       String       @unique @db.VarChar(50)
  passwordHash   String       @map("password_hash") @db.VarChar(255)
  fullName       String       @map("full_name") @db.VarChar(100)
  firstName      String?      @map("first_name") @db.VarChar(50)
  lastName       String?      @map("last_name") @db.VarChar(50)
  middleName     String?      @map("middle_name") @db.VarChar(50)
  nameSuffix     String?      @map("name_suffix") @db.VarChar(15)
  role           UserRole     @default(teacher)
  adminSessionVersion Int     @default(0) @map("admin_session_version")
  failedLoginAttempts Int     @default(0) @map("failed_login_attempts")
  loginLockedUntil DateTime?  @map("login_locked_until")
  loginLockId    String?      @map("login_lock_id") @db.Uuid
  apiToken       String?      @unique @map("api_token") @db.VarChar(128)
  learnerPurgePending Boolean @default(false) @map("learner_purge_pending")
  lastLearnerPurgeAt DateTime? @map("last_learner_purge_at")
  learnerDataVersion Int       @default(0) @map("learner_data_version")
  section        String?      @db.VarChar(50)
  schoolId       String?      @map("school_id") @db.VarChar(6)
  schoolName     String?      @map("school_name") @db.VarChar(150)
  email          String?      @unique @db.VarChar(254)
  emailVerifiedAt DateTime?   @map("email_verified_at")
  twoFactorEnabled Boolean     @default(false) @map("two_factor_enabled")
  twoFactorSecret String?      @map("two_factor_secret") @db.VarChar(255)
  resetTokenHash  String?      @unique @map("reset_token_hash") @db.VarChar(128)
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  inviteCodes       InviteCode[] @relation("GeneratedInvites")
  redeemedInvites    InviteCode[] @relation("RedeemedInvites")
  schoolYears       SchoolYear[]
  classSections     ClassSection[]
  classArchives     ClassArchive[]
  learners          Learner[]
  teacherSessions   AssessmentSession[] @relation("TeacherAssessmentSessions")
  hostSessions      HostSession[]       @relation("TeacherHostSessions")
  assessmentContent AssessmentContent[]
  unlockRequests AccountUnlockRequest[] @relation("RequestedUnlocks")
  resolvedUnlockRequests AccountUnlockRequest[] @relation("ResolvedUnlocks")

  @@map("users")
}

model AccountUnlockRequest {
  id           String    @id @default(uuid()) @db.Uuid
  teacherId    Int       @map("teacher_id")
  lockId       String    @map("lock_id") @db.Uuid
  lockedUntil  DateTime  @map("locked_until")
  status       String    @default("pending") @db.VarChar(16)
  createdAt    DateTime  @default(now()) @map("created_at")
  resolvedAt   DateTime? @map("resolved_at")
  resolvedById Int?      @map("resolved_by_id")
  teacher      User      @relation("RequestedUnlocks", fields: [teacherId], references: [id], onDelete: Cascade)
  resolvedBy   User?     @relation("ResolvedUnlocks", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([teacherId, lockId])
  @@index([createdAt, id])
  @@map("account_unlock_requests")
}


model InviteCode {
  id          Int       @id @default(autoincrement())
  code        String    @unique @db.VarChar(50)
  isUsed      Boolean   @default(false) @map("is_used")
  expiresAt   DateTime? @map("expires_at")
  generatedBy Int?      @map("generated_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  usedById    Int?      @map("used_by_id")
  usedAt      DateTime? @map("used_at")
  revokedAt   DateTime? @map("revoked_at")

  generator User? @relation("GeneratedInvites", fields: [generatedBy], references: [id], onDelete: SetNull)
  redeemedBy User? @relation("RedeemedInvites", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([usedById])

  @@index([isUsed])
  @@index([expiresAt])
  @@map("invite_codes")
}

model SchoolYear {
  id String @id @default(uuid()) @db.Uuid
  teacherId Int @map("teacher_id")
  startYear Int @map("start_year")
  archivedAt DateTime? @map("archived_at")
  deletedAt DateTime? @map("deleted_at")
  label String @db.VarChar(9)
  createdAt DateTime @default(now()) @map("created_at")
  teacher User @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  sections ClassSection[]
  @@unique([id, teacherId])
  @@index([teacherId, startYear])
  @@map("school_years")
}

model ClassSection {
  id String @id @default(uuid()) @db.Uuid
  teacherId Int @map("teacher_id")
  schoolYearId String @map("school_year_id") @db.Uuid
  name String @db.VarChar(50)
  nameKey String @map("name_key") @db.VarChar(50)
  archivedAt DateTime? @map("archived_at")
  restoredArchiveId String? @map("restored_archive_id") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @default(now()) @map("created_at")
  teacher User @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  schoolYear SchoolYear @relation(fields: [schoolYearId, teacherId], references: [id, teacherId], onDelete: Cascade, map: "class_sections_year_owner_fkey")
  learners Learner[]
  @@unique([id, teacherId])
  @@index([schoolYearId, nameKey])
  @@index([teacherId, schoolYearId])
  @@map("class_sections")
}

model ClassArchive {
  id String @id @default(uuid()) @db.Uuid
  teacherId Int @map("teacher_id")
  sourceSectionId String @map("source_section_id") @db.Uuid
  schoolYearLabel String @map("school_year_label") @db.VarChar(9)
  sectionName String @map("section_name") @db.VarChar(50)
  learnerCount Int @map("learner_count")
  kind String @default("section") @db.VarChar(12)
  sourceLearnerId Int? @map("source_learner_id")
  learnerName String? @map("learner_name") @db.VarChar(220)
  encryptedSnapshot String @map("encrypted_snapshot") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  teacher User @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  @@index([teacherId, createdAt])
  @@map("class_archives")
}

model Learner {
  id          Int      @id @default(autoincrement())
  lrn         String   @db.VarChar(12)
  firstName   String   @map("first_name") @db.VarChar(50)
  middleName  String?  @map("middle_name") @db.VarChar(50)
  suffix      String?  @db.VarChar(20)
  sex         String?  @db.VarChar(10)
  lastName    String   @map("last_name") @db.VarChar(50)
  gradeLevel  Int      @default(3) @map("grade_level")
  section     String?  @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")
  teacherId   Int      @map("teacher_id")
  classSectionId String @map("class_section_id") @db.Uuid

  classSection ClassSection @relation(fields: [classSectionId, teacherId], references: [id, teacherId], onDelete: Cascade, map: "learners_class_owner_fkey")
  teacher            User                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  assessmentSessions AssessmentSession[]
  hostSessions       HostSession[]

  @@index([teacherId])
  @@index([section])
  @@index([classSectionId, teacherId])
  @@unique([classSectionId, lrn])
  @@map("learners")
}

model AssessmentSession {
  id                  Int              @id @default(autoincrement())
  learnerId           Int              @map("learner_id")
  teacherId           Int              @map("teacher_id")
  assessmentPeriod    AssessmentPeriod @map("assessment_period")
  dateAdministered    DateTime         @db.Date @map("date_administered")
  overallClassification String?        @map("overall_classification") @db.VarChar(100)
  isCompleted         Boolean          @default(false) @map("is_completed")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  learner             Learner          @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  teacher             User             @relation("TeacherAssessmentSessions", fields: [teacherId], references: [id], onDelete: Cascade)
  hostSessions        HostSession[]
  sessionMetrics      SessionMetrics?
  letterResults       LetterTaskResult[]
  wordResults         WordTaskResult[]
  passageMiscues      PassageMiscue[]
  comprehensionResults ComprehensionResult[]

  @@index([learnerId])
  @@index([teacherId])
  @@index([assessmentPeriod])
  @@index([dateAdministered])
  @@map("assessment_sessions")
}

model HostSession {
  id                  Int       @id @default(autoincrement())
  code                String    @unique @db.VarChar(20)
  teacherId           Int       @map("teacher_id")
  learnerId           Int?      @map("learner_id")
  assessmentSessionId Int?      @map("assessment_session_id")
  stage               String    @default("waiting") @db.VarChar(30)
  currentContent      String?   @map("current_content") @db.Text
  storyTitle          String?   @map("story_title") @db.VarChar(200)
  ended               Boolean   @default(false)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  linkedAt            DateTime? @map("linked_at")
  passageStartedAt    DateTime? @map("passage_started_at")
  passagePausedAt     DateTime? @map("passage_paused_at")
  passagePausedSeconds Int      @default(0) @map("passage_paused_seconds")

  teacher             User              @relation("TeacherHostSessions", fields: [teacherId], references: [id], onDelete: Cascade)
  learner             Learner?          @relation(fields: [learnerId], references: [id], onDelete: SetNull)
  assessmentSession   AssessmentSession? @relation(fields: [assessmentSessionId], references: [id], onDelete: SetNull)

  @@index([teacherId])
  @@index([learnerId])
  @@index([assessmentSessionId])
  @@index([stage])
  @@index([ended])
  @@map("host_sessions")
}

model AssessmentContent {
  id               Int      @id @default(autoincrement())
  teacherId        Int      @map("teacher_id")
  assessmentPeriod AssessmentPeriod @map("assessment_period")
  category         String   @db.VarChar(20)
  position         Int
  content          String   @db.Text
  storyTitle       String?  @map("story_title") @db.VarChar(200)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  teacher User @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, assessmentPeriod, category, position])
  @@index([teacherId, assessmentPeriod, category, position])
  @@map("assessment_content")
}

model SessionMetrics {
  sessionId          Int      @id @map("session_id")
  task1Score         Int      @default(0) @map("task1_score")
  task2Score         Int      @default(0) @map("task2_score")
  totalMiscues       Int      @default(0) @map("total_miscues")
  miscueAccuracy     Decimal  @default(100.00) @map("miscue_accuracy") @db.Decimal(5, 2)
  comprehensionScore Int      @default(0) @map("comprehension_score")
  timerSeconds       Int?     @map("timer_seconds")
  classificationLabel String?  @map("classification_label") @db.VarChar(100)
  experienceRating   Int?     @map("experience_rating")
  observationLevel   Int?     @map("observation_level")
  remarks            String?  @db.Text

  session AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_metrics")
}

model LetterTaskResult {
  id         Int      @id @default(autoincrement())
  sessionId  Int      @map("session_id")
  letterIndex Int     @map("letter_index")
  letter     String   @db.Char(1)
  isCorrect  Boolean  @map("is_correct")
  recordedAt DateTime @default(now()) @map("recorded_at")

  session AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, letterIndex])
  @@map("letter_task_results")
}

model WordTaskResult {
  id         Int      @id @default(autoincrement())
  sessionId  Int      @map("session_id")
  wordIndex  Int      @map("word_index")
  word       String   @db.VarChar(100)
  isCorrect  Boolean  @map("is_correct")
  recordedAt DateTime @default(now()) @map("recorded_at")

  session AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, wordIndex])
  @@map("word_task_results")
}

model PassageMiscue {
  id         Int        @id @default(autoincrement())
  sessionId  Int        @map("session_id")
  wordIndex  Int        @map("word_index")
  miscueType MiscueType @map("miscue_type")
  misreadWord String?   @map("misread_word") @db.VarChar(100)
  recordedAt DateTime   @default(now()) @map("recorded_at")

  session AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, wordIndex])
  @@map("passage_miscues")
}

model ComprehensionResult {
  id            Int      @id @default(autoincrement())
  sessionId     Int      @map("session_id")
  questionIndex Int      @map("question_index")
  isCorrect     Boolean  @map("is_correct")
  recordedAt    DateTime @default(now()) @map("recorded_at")

  session AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, questionIndex])
  @@map("comprehension_results")
}

/*
 * Public landing-page submissions. Bugs and feedback are deliberately two
 * separate tables so the administrator dashboard can show them as two distinct
 * fields rather than one mixed inbox.
 */
model BugReport {
  id         Int      @id @default(autoincrement())
  name       String?  @db.VarChar(100)
  contact    String?  @db.VarChar(254)
  message    String   @db.VarChar(4000)
  pageUrl    String?  @map("page_url") @db.VarChar(500)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  isResolved Boolean  @default(false) @map("is_resolved")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([isResolved])
  @@map("bug_reports")
}

model Feedback {
  id         Int      @id @default(autoincrement())
  name       String?  @db.VarChar(100)
  contact    String?  @db.VarChar(254)
  message    String   @db.VarChar(4000)
  pageUrl    String?  @map("page_url") @db.VarChar(500)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  isResolved Boolean  @default(false) @map("is_resolved")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([isResolved])
  @@map("feedback")
}

model AdminAuditEvent {
  id              String   @id @default(uuid()) @db.Uuid
  actorId         Int      @map("actor_id")
  teacherId       Int?     @map("teacher_id")
  event           String   @db.VarChar(40)
  entityCount     Int      @default(1) @map("entity_count")
  groupKey        String?  @unique @map("group_key") @db.VarChar(100)
  encryptedDetail String?  @map("encrypted_detail") @db.Text
  occurredAt      DateTime @default(now()) @map("occurred_at")
  createdAt       DateTime @default(now()) @map("created_at")
  @@index([teacherId, createdAt])
  @@index([createdAt])
  @@map("admin_audit_events")
}
model AdminRecoveryItem {
  id                String    @id @default(uuid()) @db.Uuid
  actorId           Int       @map("actor_id")
  teacherId         Int?      @map("teacher_id")
  kind              String    @db.VarChar(30)
  entityCount       Int       @map("entity_count")
  encryptedSnapshot String    @map("encrypted_snapshot") @db.Text
  createdAt         DateTime  @default(now()) @map("created_at")
  expiresAt         DateTime  @map("expires_at")
  restoredAt        DateTime? @map("restored_at")
  restoredById      Int?      @map("restored_by_id")
  @@index([teacherId, createdAt])
  @@index([expiresAt])
  @@map("admin_recovery_items")
}
model SecurityRateBucket {
  key       String   @id @db.VarChar(64)
  count     Int      @default(1)
  expiresAt DateTime @map("expires_at")
  @@index([expiresAt])
  @@map("security_rate_buckets")
}
