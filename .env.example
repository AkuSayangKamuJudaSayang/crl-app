# Copy this file to .env.local before starting CRL-App locally.
# Never commit .env.local or real credentials.

# In Supabase, open the project's Connect panel and copy the Postgres URI.
# For an IPv4-only local network, use the Session pooler URI (port 5432).
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@YOUR_POOLER_HOST:5432/postgres"

# Use the Direct connection URI for Prisma migrations when IPv6 is available.
# On an IPv4-only network, the Session pooler URI can also be used here.
DIRECT_URL="postgresql://postgres:YOUR_DATABASE_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Generate a local secret with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
JWT_SECRET="replace-with-a-long-random-local-secret"

# Optional realtime synchronization used by teacher/learner assessment screens.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY="replace-with-your-publishable-key"
