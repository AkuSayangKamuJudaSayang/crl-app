{
  "name": "CRL-App Teacher",
  "short_name": "CRL-App Teacher",
  "description": "Teacher interface for Comprehensive Rapid Literacy Assessment.",
  "id": "/teacher",
  "start_url": "/teacher",
  "scope": "/teacher",
  "display": "standalone",
  "display_override": ["standalone"],
  "orientation": "portrait-primary",
  "background_color": "#f8fbff",
  "theme_color": "#1559a6",
  "lang": "en-PH",
  "dir": "ltr",
  "categories": ["education", "productivity"],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
